{% extends 'base.html.twig' %}

{% block title %}История заказа — {{ order_info.client_full_name ?? '' }}, {{ order_info.event_date ?? '' }}{% endblock %}

{% block body %}
{% set op_labels = {
    'CREATE':        'Создание',
    'UPDATE':        'Обновление',
    'UPDATE_STATUS': 'Смена статуса',
    'UPDATE_DISHES': 'Состав заказа',
    'DELETE':        'Удаление',
    'CLOSE_RESERVE': 'Закрытие резерва',
    'CANCEL':        'Отмена заказа',
    'NOTIFICATION':  'Уведомление',
    'SEED':          'Демо-данные'
} %}
  <div class="topline">
    <div>
      <h1>История заказа</h1>
      {% if order_info %}
        <div class="muted">{{ order_info.client_full_name }}, {{ order_info.event_date }} · {{ order_info.event_type }}</div>
      {% else %}
        <div class="muted">Лог операций и изменения статусов</div>
      {% endif %}
    </div>
    <a class="btn" href="{{ path('orders_index') }}">Назад к заказам</a>
  </div>

  <section class="card" style="margin-top:16px;">
    <table>
      <thead>
        <tr>
          <th>Время</th>
          <th>Операция</th>
          <th>Описание</th>
        </tr>
      </thead>
      <tbody>
        {% for log in logs %}
          <tr>
            <td>{{ log.operation_date }}</td>
            <td><span class="pill warn">{{ op_labels[log.operation_type] ?? log.operation_type }}</span></td>
            <td>{{ log.description }}</td>
          </tr>
        {% else %}
          <tr>
            <td colspan="3" class="muted">История операций для этого заказа пока пуста</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
{% endblock %}
