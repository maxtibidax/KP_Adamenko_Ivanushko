{% extends 'base.html.twig' %}

{% block title %}Панель управления{% endblock %}

{% block body %}
  <div class="topline">
    <div>
      <h1>Панель управления</h1>
      <div class="page-subtitle">Оперативное состояние заказов и склада</div>
    </div>
    <a class="btn" href="{{ path('orders_index') }}">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
      Открыть заказы
    </a>
  </div>

  <section class="grid stats">
    <div class="card stat">
      <div class="stat-label">Всего заказов</div>
      <div class="value">{{ summary.orders_total }}</div>
    </div>
    <div class="card stat">
      <div class="stat-label">Активные заказы</div>
      <div class="value">{{ summary.active_orders }}</div>
    </div>
    <div class="card stat">
      <div class="stat-label">Выручка (выполненные)</div>
      <div class="value">{{ summary.revenue|number_format(0, ',', ' ') }} <small style="font-size:.5em;font-weight:600">руб.</small></div>
      {% if summary.revenue_forecast > 0 %}
        <div class="value-sub">+ {{ summary.revenue_forecast|number_format(0, ',', ' ') }} руб. прогноз</div>
      {% endif %}
    </div>
    <div class="card stat">
      <div class="stat-label">Низкие остатки</div>
      <div class="value" style="{{ summary.low_stock > 0 ? 'color:var(--danger)' : '' }}">{{ summary.low_stock }}</div>
    </div>
  </section>

  <section class="card section-gap">
    <h2>Выручка по месяцам <small class="muted" style="font-size:.75em;font-weight:500">(последние 6 месяцев)</small></h2>
    {% if chart_data|length > 0 %}
      <div style="position:relative;height:240px;margin-top:14px;">
        <canvas id="revenueChart"></canvas>
      </div>
    {% else %}
      <div class="muted" style="margin-top:12px;">Нет данных о выручке за последние месяцы.</div>
    {% endif %}
  </section>

  <section class="grid two section-gap">
    <div class="card">
      <h2 style="margin-bottom:14px">Ближайшие мероприятия</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Дата</th>
              <th>Клиент</th>
              <th>Тип</th>
              <th>Статус</th>
              <th>Стоимость</th>
            </tr>
          </thead>
          <tbody>
          {% for order in upcoming %}
            <tr>
              <td>{{ order.event_date }}</td>
              <td>{{ order.client_full_name }}</td>
              <td>{{ order.event_type }}</td>
              <td><span class="pill warn">{{ order.status }}</span></td>
              <td style="white-space:nowrap">{{ order.total_cost|number_format(0, ',', ' ') }} руб.</td>
            </tr>
          {% else %}
            <tr><td colspan="5" class="muted">Активных мероприятий пока нет</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <h2 style="margin-bottom:14px">Журнал операций</h2>
      {% set op_labels = {
        'CREATE':        'Создание',
        'UPDATE':        'Обновление',
        'UPDATE_STATUS': 'Смена статуса',
        'UPDATE_DISHES': 'Состав заказа',
        'DELETE':        'Удаление',
        'CLOSE_RESERVE': 'Закрытие резерва',
        'CANCEL':        'Отмена заказа',
        'NOTIFICATION':  'Уведомление',
        'SEED':          'Демо-данные'
      } %}
      <div class="table-wrap">
        <table style="table-layout:fixed">
          <colgroup>
            <col style="width:130px">
            <col style="width:125px">
            <col>
          </colgroup>
          <thead>
            <tr><th>Время</th><th>Операция</th><th>Описание</th></tr>
          </thead>
          <tbody>
          {% for log in logs %}
            <tr>
              {# Применяем красивый формат даты и времени #}
              <td style="font-size:12px;color:var(--muted)">{{ log.operation_date|date('d.m.Y H:i') }}</td>
              <td><span class="pill">{{ op_labels[log.operation_type] ?? log.operation_type }}</span></td>
              <td title="{{ log.description }}" style="word-break:break-word;white-space:normal;font-size:13px">{{ log.description }}</td>
            </tr>
          {% else %}
            <tr><td colspan="3" class="muted">Журнал заполнится после изменений</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {% if chart_data|length > 0 %}
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
  <script>
    (function () {
      var raw = {{ chart_data|json_encode|raw }};

      var labels   = raw.map(function(d) { return d.month; });
      var revenues = raw.map(function(d) { return d.revenue; });
      var forecasts = raw.map(function(d) { return d.forecast; });

      function fmtRub(v) {
        if (v >= 1000000) return (v / 1000000).toFixed(1).replace('.', ',') + ' млн';
        if (v >= 1000)    return Math.round(v / 1000) + ' тыс.';
        return Math.round(v) + ' ₽';
      }

      var ctx = document.getElementById('revenueChart').getContext('2d');
      new Chart(ctx, {
        type: 'bar',
        data: {
          labels: labels,
          datasets: [
            {
              label: 'Выполнено',
              data: revenues,
              backgroundColor: 'rgba(13,148,136,0.80)',
              borderColor:     'rgba(13,148,136,1)',
              borderWidth: 1,
              borderRadius: 5,
              stack: 'revenue'
            },
            {
              label: 'Прогноз',
              data: forecasts,
              backgroundColor: 'rgba(217,119,6,0.55)',
              borderColor:     'rgba(217,119,6,0.9)',
              borderWidth: 1,
              borderRadius: 5,
              stack: 'revenue'
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: {
              position: 'top',
              labels: { font: { size: 12, family: 'Inter' }, padding: 16, usePointStyle: true, pointStyle: 'rectRounded' }
            },
            tooltip: {
              backgroundColor: '#0f172a',
              titleFont: { size: 12 },
              bodyFont: { size: 12 },
              padding: 10,
              cornerRadius: 8,
              callbacks: {
                label: function(ctx) {
                  return ' ' + ctx.dataset.label + ': ' + fmtRub(ctx.parsed.y);
                },
                footer: function(items) {
                  var total = items.reduce(function(s, i) { return s + i.parsed.y; }, 0);
                  return total > 0 ? 'Итого: ' + fmtRub(total) : '';
                }
              }
            }
          },
          scales: {
            x: {
              stacked: true,
              grid: { display: false },
              ticks: { font: { size: 11, family: 'Inter' }, color: '#64748b' }
            },
            y: {
              stacked: true,
              beginAtZero: true,
              ticks: {
                font: { size: 11, family: 'Inter' },
                color: '#64748b',
                callback: function(v) { return fmtRub(v); }
              },
              grid: { color: 'rgba(0,0,0,0.05)' }
            }
          }
        }
      });
    })();
  </script>
  {% endif %}
{% endblock %}
