{% extends 'base.html.twig' %}

{% block title %}Отчет по заказам{% endblock %}

{% block body %}
  <div class="topline">
    <div>
      <h1>Отчет по заказам</h1>
      <div class="page-subtitle">Отбор по периоду, статусу и типу мероприятия</div>
    </div>
    <div class="table-actions">
      <a class="btn ghost" href="{{ path('reports_profitability') }}">Прибыльность блюд</a>
      <a class="btn ghost" href="{{ path('reports_warehouse') }}">Склад и поставки</a>
      <a class="btn secondary" href="{{ path('reports_orders', filters|merge({format: 'pdf'})) }}">PDF</a>
      <a class="btn secondary" href="{{ path('reports_orders', filters|merge({format: 'xlsx'})) }}">Excel</a>
    </div>
  </div>

  <form class="toolbar" method="get">
    <label>С даты <input type="date" name="date_from" value="{{ filters.date_from }}"></label>
    <label>По дату <input type="date" name="date_to" value="{{ filters.date_to }}"></label>
    <label>Статус
      <select name="status">
        <option value="">Все</option>
        {% for status in statuses %}
          <option value="{{ status }}" {% if filters.status == status %}selected{% endif %}>{{ status }}</option>
        {% endfor %}
      </select>
    </label>
    <label>Тип мероприятия
      <select name="event_type">
        <option value="">Все</option>
        {% for type in event_types %}
          <option value="{{ type }}" {% if filters.event_type == type %}selected{% endif %}>{{ type }}</option>
        {% endfor %}
      </select>
    </label>
    <button class="btn" type="submit">Сформировать</button>
  </form>

  <section class="grid stats">
    <div class="card stat"><div class="stat-label">Заказов</div><div class="value">{{ report.orders|length }}</div></div>
    <div class="card stat"><div class="stat-label">Стоимость</div><div class="value">{{ report.total_revenue|number_format(0, ',', ' ') }} руб.</div></div>
    <div class="card stat"><div class="stat-label">Предоплата</div><div class="value">{{ report.total_prepayment|number_format(0, ',', ' ') }} руб.</div></div>
    <div class="card stat"><div class="stat-label">К оплате</div><div class="value">{{ (report.total_revenue - report.total_prepayment)|number_format(0, ',', ' ') }} руб.</div></div>
  </section>

  <section class="grid two" style="margin-top:16px">
    <div class="card">
      <h2 style="margin-bottom:12px">Выручка по типам мероприятий</h2>
      <div class="table-wrap">
      <table id="bytype-table" class="sortable-table">
        <thead><tr>
          <th data-col="0" class="sort-th">Тип <span class="sort-icon">⇕</span></th>
          <th data-col="1" class="sort-th">Выручка <span class="sort-icon">⇕</span></th>
          <th>Диаграмма</th>
        </tr></thead>
        <tbody>
        {% for row in report.by_type %}
          <tr>
            <td data-val="{{ row.event_type }}">{{ row.event_type }}</td>
            <td data-val="{{ row.revenue }}">{{ row.revenue|number_format(0, ',', ' ') }} руб.</td>
            <td><div class="bar"><span style="width: {{ report.max_revenue > 0 ? (row.revenue / report.max_revenue * 100)|round(1) : 0 }}%"></span></div></td>
          </tr>
        {% else %}
          <tr><td colspan="3" class="muted">Нет данных для диаграммы</td></tr>
        {% endfor %}
        </tbody>
      </table>
      </div>
    </div>
    <div class="card">
      <h2>Параметры отчета</h2>
      <p><strong>Период:</strong> {{ filters.date_from }} — {{ filters.date_to }}</p>
      <p><strong>Статус:</strong> {{ filters.status ?: 'Все' }}</p>
      <p><strong>Тип:</strong> {{ filters.event_type ?: 'Все' }}</p>
    </div>
  </section>

  <section class="card" style="margin-top:16px">
    <h2 style="margin-bottom:12px">Заказы за период</h2>
    <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Дата</th>
          <th>Клиент</th>
          <th>Менеджер</th>
          <th>Тип</th>
          <th>Статус</th>
          <th>Стоимость</th>
          <th>Предоплата</th>
          <th>Оплата</th>
        </tr>
      </thead>
      <tbody>
      {% for order in report.orders %}
        <tr>
          <td>{{ order.event_date }}</td>
          <td>{{ order.client_full_name }}</td>
          <td>{{ order.manager_full_name }}</td>
          <td>{{ order.event_type }}</td>
          <td>{{ order.status }}</td>
          <td>{{ order.total_cost|number_format(2, ',', ' ') }} руб.</td>
          <td>{{ order.prepayment_amount|number_format(2, ',', ' ') }} руб.</td>
          <td>{% if order.is_fully_paid %}Полная{% else %}Частичная{% endif %}</td>
        </tr>
      {% else %}
        <tr><td colspan="8" class="muted">За выбранный период заказов нет</td></tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
  </section>
{% endblock %}
