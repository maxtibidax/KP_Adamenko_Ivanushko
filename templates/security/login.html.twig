{% extends 'base.html.twig' %}

{% block title %}Вход{% endblock %}

{% block body %}
<div style="max-width:400px;margin:60px auto;">
  {% if error %}
    <div class="flash danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
  {% endif %}

  {% if app.user %}
    <div style="margin-bottom:20px">
      Вы вошли как {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Выйти</a>
    </div>
  {% endif %}

  <h1 style="margin-bottom:24px">Вход в систему</h1>

  <form method="post">
    <label style="margin-bottom:16px">
      Имя пользователя
      <input type="text" value="{{ last_username }}" name="_username" id="username" autocomplete="username" required autofocus
             style="width:100%;margin-top:6px">
    </label>

    <label style="margin-bottom:20px">
      Пароль
      <input type="password" name="_password" id="password" autocomplete="current-password" required
             style="width:100%;margin-top:6px">
    </label>

    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

    <button class="btn" type="submit" style="width:100%">Войти</button>
  </form>

  <p style="margin-top:20px;text-align:center">
    Нет аккаунта? <a href="{{ path('app_register') }}" style="color:var(--brand);font-weight:600">Зарегистрироваться</a>
  </p>
</div>
{% endblock %}
