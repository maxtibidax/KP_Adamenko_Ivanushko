<!doctype html>
<html lang="ru" data-status-done="{{ STATUS_DONE }}" data-status-cancelled="{{ STATUS_CANCELLED }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Система управления банкетными заказами и кейтерингом">
  <title>{% block title %}Кейтеринг{% endblock %}</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>

  {# Mobile header (fixed, visible only on mobile) #}
  <header class="mobile-header" aria-label="Мобильная шапка">
    <span class="brand-mobile">🍽 Кейтеринг</span>
  </header>

  {# Hamburger button #}
  <button class="hamburger" id="hamburger-btn" aria-label="Открыть меню" aria-expanded="false">
    <span></span>
    <span></span>
    <span></span>
  </button>

  {# Overlay (mobile sidebar backdrop) #}
  <div class="sidebar-overlay" id="sidebar-overlay" aria-hidden="true"></div>

  <div class="layout">
    <aside class="sidebar" id="sidebar" role="navigation" aria-label="Основная навигация">
      {% set route = app.request.attributes.get('_route') ?? '' %}
      <div class="brand">Кейтеринг</div>

      {% if app.user %}
        <div class="sidebar-user">
          <strong>{{ app.user.fullName|default(app.user.userIdentifier) }}</strong><br>
          <span class="muted">{{ app.user.userIdentifier }}</span><br>
          <a href="{{ path('app_logout') }}" class="muted">Выйти</a>
        </div>
      {% endif %}

      <nav class="nav">
        <a class="{% if route == 'dashboard' %}active{% endif %}" href="{{ path('dashboard') }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          Панель
        </a>
        <a class="{% if route starts with 'orders_' %}active{% endif %}" href="{{ path('orders_index') }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
          Банкетные заказы
        </a>
        <a class="{% if route starts with 'clients_' %}active{% endif %}" href="{{ path('clients_index') }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
          Клиенты
        </a>
        <a class="{% if route starts with 'menu_' %}active{% endif %}" href="{{ path('menu_index') }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 002-2V2"/><path d="M7 2v20"/><path d="M21 15V2s-5 2-5 8v5"/><circle cx="21" cy="18" r="3"/></svg>
          Меню/Блюда
        </a>
        <a class="{% if route starts with 'references_' %}active{% endif %}" href="{{ path('references_index') }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="17" y1="11" x2="23" y2="11"/></svg>
          Персонал и снабжение
        </a>
        <a class="{% if route starts with 'warehouse_' %}active{% endif %}" href="{{ path('warehouse_index') }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          Склад и поставки
        </a>
        <a class="{% if route starts with 'reports_' %}active{% endif %}" href="{{ path('reports_orders') }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          Отчеты
        </a>
      </nav>
    </aside>

    <main>
      {% for type, messages in app.flashes %}
        {% for message in messages %}
          <div class="flash {{ type }}" role="alert">{{ message }}</div>
        {% endfor %}
      {% endfor %}
      {% block body %}{% endblock %}
    </main>
  </div>

  <script>
    /* ── Mobile sidebar toggle ── */
    (function () {
      var btn     = document.getElementById('hamburger-btn');
      var sidebar = document.getElementById('sidebar');
      var overlay = document.getElementById('sidebar-overlay');

      function open() {
        sidebar.classList.add('open');
        overlay.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }

      function close() {
        sidebar.classList.remove('open');
        overlay.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }

      btn.addEventListener('click', function () {
        sidebar.classList.contains('open') ? close() : open();
      });

      overlay.addEventListener('click', close);

      /* Close drawer when a nav link is clicked */
      sidebar.querySelectorAll('.nav a').forEach(function (a) {
        a.addEventListener('click', close);
      });

      /* Close on Escape */
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') close();
      });
    })();

    /* ── Modal helpers ── */
    function openModal(id)  { document.getElementById(id).showModal(); }
    function closeModal(id) { document.getElementById(id).close(); }

    /* ── Dish row ── */
    function addDishRow(targetId) {
      var source = document.querySelector('#dish-template').content.cloneNode(true);
      document.querySelector('#' + (targetId || 'dish-lines')).appendChild(source);
    }

    /* ── Product row ── */
    function addProductRow() {
      var source = document.querySelector('#product-template').content.cloneNode(true);
      document.querySelector('#product-lines').appendChild(source);
    }

    /* ── Remove line item ── */
    function removeLine(button) {
      var container = button.closest('.line-items');
      if (container && container.children.length > 1) button.closest('.line-item').remove();
    }

    /* ── Status change confirm ── */
    function confirmStatusChange(select) {
      if (select.value === select.dataset.current) return;
      var statusDone = document.documentElement.dataset.statusDone;
      var finalText = select.value === statusDone
        ? 'Перевести заказ в статус "' + statusDone + '"? После этого отмена заказа будет недоступна.'
        : 'Изменить статус заказа на "' + select.value + '"?';
      if (confirm(finalText)) {
        select.form.submit();
      } else {
        select.value = select.dataset.current;
      }
    }

    /* ── Supply status confirm ── */
    function confirmSupplyStatusChange(select) {
      if (select.value === select.dataset.current) return;
      if (select.value === 'Получено' && !confirm('Отметить заявку как полученную и пополнить склад по ее составу?')) {
        select.value = select.dataset.current;
        return;
      }
      select.form.submit();
    }

    /* ── Future-date validation ── */
    document.addEventListener('submit', function (event) {
      var invalid = null;
      event.target.querySelectorAll('[data-future-date]').forEach(function (input) {
        input.setCustomValidity('');
        if (input.value && input.min && input.value < input.min) {
          input.setCustomValidity('Дата активного заказа не может быть в прошлом.');
          invalid = invalid || input;
        }
      });
      if (invalid) {
        event.preventDefault();
        invalid.reportValidity();
      }
    });
    /* ── Universal client-side table sort ── */
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('.sortable-table').forEach(function (table) {
        var tbody = table.querySelector('tbody');
        if (!tbody) return;

        table.querySelectorAll('th.sort-th').forEach(function (th) {
          th.addEventListener('click', function () {
            var col = parseInt(th.dataset.col, 10);
            var isAsc = th.classList.contains('asc');

            /* Reset all headers */
            table.querySelectorAll('th.sort-th').forEach(function (h) {
              h.classList.remove('asc', 'desc');
            });

            th.classList.add(isAsc ? 'desc' : 'asc');
            var dir = isAsc ? -1 : 1;

            var rows = Array.from(tbody.querySelectorAll('tr'));
            rows.sort(function (a, b) {
              var tdA = a.querySelectorAll('td')[col];
              var tdB = b.querySelectorAll('td')[col];
              if (!tdA || !tdB) return 0;

              /* Use data-val if available, else text */
              var va = (tdA.dataset.val !== undefined ? tdA.dataset.val : tdA.textContent).trim();
              var vb = (tdB.dataset.val !== undefined ? tdB.dataset.val : tdB.textContent).trim();

              /* Numeric sort if both look like numbers */
              var na = parseFloat(va.replace(/[^\d.,-]/g, '').replace(',', '.'));
              var nb = parseFloat(vb.replace(/[^\d.,-]/g, '').replace(',', '.'));
              if (!isNaN(na) && !isNaN(nb)) return (na - nb) * dir;

              return va.localeCompare(vb, 'ru') * dir;
            });

            rows.forEach(function (r) { tbody.appendChild(r); });
          });
        });
      });
    });
  </script>
</body>
</html>
