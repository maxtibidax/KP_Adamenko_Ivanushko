<!doctype html>
<html lang="ru" data-status-done="{{ STATUS_DONE }}" data-status-cancelled="{{ STATUS_CANCELLED }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Кейтеринг{% endblock %}</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="layout" id="app-layout">
    <div class="mobile-topline">
      <div class="brand">Кейтеринг</div>
      <button type="button" class="menu-toggle" id="menu-toggle" aria-label="Открыть меню">☰ Меню</button>
    </div>
    <aside class="sidebar" id="sidebar">
      {% set route = app.request.attributes.get('_route') ?? '' %}
      <div class="brand">Кейтеринг</div>
      {% if app.user %}
        <div style="padding: 1rem; border-bottom: 1px solid #dee2e6; margin-bottom: 1rem;">
            Вы вошли как <strong>{{ app.user.userIdentifier }}</strong><br>
            <a href="{{ path('app_logout') }}" class="muted">Выйти</a>
        </div>
      {% endif %}
      <nav class="nav">
        <a class="{% if route == 'dashboard' %}active{% endif %}" href="{{ path('dashboard') }}">Панель</a>
        <a class="{% if route starts with 'orders_' %}active{% endif %}" href="{{ path('orders_index') }}">Банкетные заказы</a>
        <a class="{% if route starts with 'clients_' %}active{% endif %}" href="{{ path('clients_index') }}">Клиенты</a>
        <a class="{% if route starts with 'menu_' %}active{% endif %}" href="{{ path('menu_index') }}">Меню/Блюда</a>
        <a class="{% if route starts with 'references_' %}active{% endif %}" href="{{ path('references_index') }}">Персонал и снабжение</a>
        <a class="{% if route starts with 'warehouse_' %}active{% endif %}" href="{{ path('warehouse_index') }}">Склад и поставки</a>
        <a class="{% if route starts with 'reports_' %}active{% endif %}" href="{{ path('reports_orders') }}">Отчеты</a>
      </nav>
    </aside>
    <main>
      {% for type, messages in app.flashes %}
        {% for message in messages %}
          <div class="flash {{ type }}">{{ message }}</div>
        {% endfor %}
      {% endfor %}
      {% block body %}{% endblock %}
    </main>
  </div>
  <script>
    function openModal(id) { document.getElementById(id).showModal(); }
    function closeModal(id) { document.getElementById(id).close(); }
    function addDishRow(targetId) {
      const source = document.querySelector('#dish-template').content.cloneNode(true);
      document.querySelector('#' + (targetId || 'dish-lines')).appendChild(source);
    }
    function addProductRow() {
      const source = document.querySelector('#product-template').content.cloneNode(true);
      document.querySelector('#product-lines').appendChild(source);
    }
    function removeLine(button) {
      const container = button.closest('.line-items');
      if (container && container.children.length > 1) button.closest('.line-item').remove();
    }
    function confirmStatusChange(select) {
      if (select.value === select.dataset.current) return;
      const statusDone = document.documentElement.dataset.statusDone;
      const finalText = select.value === statusDone
        ? 'Перевести заказ в статус "' + statusDone + '"? После этого отмена заказа будет недоступна.'
        : 'Изменить статус заказа на "' + select.value + '"?';
      if (confirm(finalText)) {
        select.form.submit();
      } else {
        select.value = select.dataset.current;
      }
    }
    function confirmSupplyStatusChange(select) {
      if (select.value === select.dataset.current) return;
      if (select.value === 'Получено' && !confirm('Отметить заявку как полученную и пополнить склад по ее составу?')) {
        select.value = select.dataset.current;
        return;
      }
      select.form.submit();
    }

    function toggleMenu(forceClose) {
      const layout = document.getElementById('app-layout');
      if (!layout) return;
      if (forceClose) {
        layout.classList.remove('nav-open');
      } else {
        layout.classList.toggle('nav-open');
      }
    }
    document.getElementById('menu-toggle')?.addEventListener('click', function () {
      toggleMenu(false);
    });
    document.querySelectorAll('.nav a').forEach(function (link) {
      link.addEventListener('click', function () {
        if (window.matchMedia('(max-width: 900px)').matches) toggleMenu(true);
      });
    });
    document.addEventListener('click', function (event) {
      const layout = document.getElementById('app-layout');
      const sidebar = document.getElementById('sidebar');
      if (!layout || !layout.classList.contains('nav-open') || !sidebar) return;
      const toggle = document.getElementById('menu-toggle');
      if (sidebar.contains(event.target) || (toggle && toggle.contains(event.target))) return;
      toggleMenu(true);
    });
    document.addEventListener('submit', function (event) {
      let invalid = null;
      event.target.querySelectorAll('[data-future-date]').forEach(function (input) {
        input.setCustomValidity('');
        if (input.value && input.min && input.value < input.min) {
          input.setCustomValidity('Дата активного заказа не может быть в прошлом.');
          invalid = invalid || input;
        }
      });
      if (invalid) {
        event.preventDefault();
        invalid.reportValidity();
      }
    });
  </script>
</body>
</html>
